MAINZWORLD_DB_HOST=localhost
MAINZWORLD_DB_PORT=5432
MAINZWORLD_DB_NAME=mainzworld
MAINZWORLD_DB_USER=change_me
MAINZWORLD_DB_PASSWORD=change_me
# Set to "require" (or "verify-full") for managed Postgres hosts like DigitalOcean; leave unset for local dev.
MAINZWORLD_DB_SSLMODE=
# Secret used to sign stateless auth tokens for the mobile app. Generate with: openssl rand -base64 48
MAINZWORLD_JWT_SECRET=change_me
# Absolute path to the property-scraper checkout (must contain .venv/bin/python).
# Production installs it at /var/www/SaleAddressMapper; the repo path is
# services/property-scraper. Intentionally decoupled (like the portal deploy
# path) -- not a pending rename, see ARCHITECTURE.md.
MAINZWORLD_SCRAPER_DIR=/var/www/SaleAddressMapper
# Required if deploy-mainzware.sh installed Playwright's Chromium to a non-default
# location (it does: /var/www/SaleAddressMapper/.browsers, owned by www-data).
# SaleScraper passes this through to the scraper subprocess's environment only
# when it is set here -- leave unset only if the browser was installed to the
# default per-user cache path instead.
PLAYWRIGHT_BROWSERS_PATH=/var/www/SaleAddressMapper/.browsers
# Optional: least-privilege credential for the Python scraper subprocess only
# (SELECT/INSERT/UPDATE on sale_properties). See
# db_migrations/manual/scoped_scraper_role.sql. Leave unset to fall back to
# MAINZWORLD_DB_USER/PASSWORD (the scraper's original, over-privileged behavior).
MAINZWORLD_SCRAPER_DB_USER=
MAINZWORLD_SCRAPER_DB_PASSWORD=
# Optional: owner/migrator credential used only by bin/migrate_db.php (Stage 7b).
# MAINZWORLD_DB_USER/PASSWORD is being reduced to a DML-only runtime role; ALTER/
# DROP/CREATE need this separate credential instead. See
# db_migrations/manual/runtime_role.sql. Leave unset to fall back to
# MAINZWORLD_DB_USER/PASSWORD (pre-split behavior: one role does everything).
MAINZWORLD_MIGRATOR_DB_USER=
MAINZWORLD_MIGRATOR_DB_PASSWORD=
TAAPI_API_KEY=change_me